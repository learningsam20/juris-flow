# JurisFlow environment configuration.
# Copy to .env and adjust per deployment. All variables use the JAIL_ prefix.

# --- App ----------------------------------------------------------------------
JAIL_ENVIRONMENT=development
JAIL_DEBUG=false
JAIL_LOG_LEVEL=INFO
JAIL_CORS_ORIGINS=http://localhost:5601,http://127.0.0.1:5601

# --- Security (REQUIRED in production: rotate) --------------------------------
JAIL_SECRET_KEY=dev-only-change-me
JAIL_ACCESS_TOKEN_MINUTES=15
JAIL_REFRESH_TOKEN_MINUTES=10080

# Form-based auth; set to keycloak to enable OIDC user registry later.
JAIL_AUTH_PROVIDER=form

# --- Database ----------------------------------------------------------------
# SQLite (default). For Postgres, use:
#   sqlite|postgresql URL, e.g. postgresql://user:pass@localhost:5432/jurisflow
JAIL_DATABASE_URL=sqlite:///./data/jurisflow.db

# --- Storage ----------------------------------------------------------------
# JAIL_STORAGE_BACKEND=local          # local | gcs
# JAIL_DATA_DIR=data
# JAIL_UPLOAD_DIR=data/uploads
# JAIL_DOCUMENT_BUCKET=

# --- LLM (no fallback: provider must succeed or operations fail) -------------
JAIL_LLM_PROVIDER=ollama              # ollama | vertex
JAIL_LLM_MODEL=llama3.2:latest
# Dedicated model for Ask AI (grounded Q&A): stronger/fact-oriented, low temperature.
JAIL_ASK_LLM_MODEL=gemma4:latest
JAIL_ASK_LLM_TEMPERATURE=0.1
JAIL_ASK_LLM_MAX_TOKENS=2048
JAIL_LLM_TEMPERATURE=0.3
# Ollama
# JAIL_OLLAMA_BASE_URL=http://localhost:11434
# Vertex AI Model Garden (Gemini)
# JAIL_LLM_PROVIDER=vertex
# JAIL_VERTEX_PROJECT=my-gcp-project
# JAIL_VERTEX_LOCATION=us-central1
# JAIL_VERTEX_MODEL=gemini-1.5-pro
# JAIL_VERTEX_SERVICE_ACCOUNT=/path/to/sa.json

# --- Embeddings ---------------------------------------------------------------
JAIL_EMBEDDING_PROVIDER=ollama        # ollama | vertex
JAIL_EMBEDDING_MODEL=all-minilm
JAIL_EMBEDDING_DIMENSIONS=384
JAIL_EMBEDDING_BATCH_SIZE=32          # keep small; large /api/embed batches can 400 on Ollama
# JAIL_VERTEX_EMBEDDING_MODEL=text-embedding-005

# --- Vector store -------------------------------------------------------------
JAIL_VECTOR_PROVIDER=qdrant           # qdrant | vertex
# Empty qdrant URL = embedded local (LanceDB-style) mode under data/qdrant
# JAIL_QDRANT_URL=
# JAIL_QDRANT_API_KEY=
# JAIL_QDRANT_PATH=data/qdrant
# JAIL_VERTEX_VECTOR_INDEX=
# JAIL_VERTEX_VECTOR_ENDPOINT=
# JAIL_VERTEX_VECTOR_DISTANCE=COSINE

# --- OPA ----------------------------------------------------------------------
# Leave empty to use the embedded policy engine (default). Point at a real OPA
# server for full Rego runtime: format http://localhost:8181
# JAIL_OPA_URL=

# --- Ingestion ---------------------------------------------------------------
JAIL_MAX_UPLOAD_MB=20
JAIL_CHUNK_SIZE=800
JAIL_CHUNK_OVERLAP=120
# OCR for scanned image-only PDFs. tesseract (default, local) or ollama_vision.
JAIL_OCR_ENABLED=true
JAIL_OCR_PROVIDER=tesseract
# JAIL_OCR_VISION_MODEL=openbmb/minicpm-v4.6:latest
# JAIL_OCR_VISION_BASE_URL=http://localhost:11434
# JAIL_OCR_MAX_PAGES=50

# --- Sim -----------------------------------------------------------------------
# JAIL_DEFAULT_TURN_LIMIT=8
# Keep tribunal generations short so local Ollama does not hang mid-turn.
# JAIL_SIM_LLM_MAX_TOKENS=512
# JAIL_SIM_LLM_TIMEOUT_SECONDS=45
# JAIL_SIM_LLM_NUM_CTX=4096
# LLM-as-judge winner ruling: effort (low|medium|high) and the number of litigant
# exchanges ("conversations") allowed before the judge rules which side won.
# JAIL_SIM_JUDGE_EFFORT=medium
# JAIL_SIM_JUDGE_MAX_ROUNDS=3

# --- Simulation audio / TTS -------------------------------------------------
# Post-run audio (learning overview + role-play) for completed simulations.
# JAIL_TTS_ENABLED=true
# JAIL_TTS_PROVIDER=edge            # edge (online, mp3) | macos (local `say`) | none
# JAIL_TTS_DATA_DIR=data/media/simulations
# JAIL_TTS_VOICES={"judge":"en-US-GuyNeural","plaintiff":"en-US-AriaNeural"}

# --- Observability -----------------------------------------------------------
# JAIL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5604

# --- Rate limiting -----------------------------------------------------------
# JAIL_RATE_LIMIT_ENABLED=true