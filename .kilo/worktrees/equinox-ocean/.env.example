# JurisLab environment configuration (root copy).
# Copy to `.env` in this repo OR to `backend/.env`. The backend reads both.
# All variables use the JAIL_ prefix. This file mirrors backend/.env.example.
#
# Quick start:
#   make install && make seed && make start
#   open http://127.0.0.1:5273/api/v1/health

# --- App ----------------------------------------------------------------------
JAIL_ENVIRONMENT=development
JAIL_DEBUG=false
JAIL_LOG_LEVEL=INFO
JAIL_CORS_ORIGINS=http://localhost:5274,http://127.0.0.1:5274

# --- Security (REQUIRED: rotate in production, >= 32 bytes) ------------------
JAIL_SECRET_KEY=dev-only-change-me
JAIL_ACCESS_TOKEN_MINUTES=15
JAIL_REFRESH_TOKEN_MINUTES=10080
JAIL_AUTH_PROVIDER=form

# --- Database ----------------------------------------------------------------
JAIL_DATABASE_URL=sqlite:///./data/jurislab.db

# --- LLM (no fallback: provider must succeed or operations fail) -------------
JAIL_LLM_PROVIDER=ollama              # ollama | vertex
JAIL_LLM_MODEL=llama3.2:latest
# Dedicated model for Ask AI (grounded Q&A): stronger/fact-oriented, low temperature.
JAIL_ASK_LLM_MODEL=gemma4:latest
JAIL_ASK_LLM_TEMPERATURE=0.1
JAIL_ASK_LLM_MAX_TOKENS=2048
JAIL_LLM_TEMPERATURE=0.3
# JAIL_OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---------------------------------------------------------------
JAIL_EMBEDDING_PROVIDER=ollama        # ollama | vertex
JAIL_EMBEDDING_MODEL=all-minilm
JAIL_EMBEDDING_DIMENSIONS=384

# --- Vector store -------------------------------------------------------------
JAIL_VECTOR_PROVIDER=qdrant           # qdrant | vertex
# JAIL_QDRANT_URL=                    # empty -> embedded local mode (data/qdrant)
# JAIL_QDRANT_PATH=data/qdrant

# --- OPA ----------------------------------------------------------------------
# JAIL_OPA_URL=                       # empty -> embedded engine (default)

# --- Ingestion ---------------------------------------------------------------
JAIL_MAX_UPLOAD_MB=20
JAIL_CHUNK_SIZE=800
JAIL_CHUNK_OVERLAP=120
# OCR for scanned image-only PDFs. tesseract (default, local) or ollama_vision.
JAIL_OCR_ENABLED=true
JAIL_OCR_PROVIDER=tesseract
# JAIL_OCR_VISION_MODEL=openbmb/minicpm-v4.6:latest
# JAIL_OCR_VISION_BASE_URL=http://localhost:11434
# JAIL_OCR_MAX_PAGES=50

# --- Sim -----------------------------------------------------------------------
# JAIL_DEFAULT_TURN_LIMIT=8
# LLM-as-judge winner ruling: effort (low|medium|high) and the number of litigant
# exchanges ("conversations") allowed before the judge rules which side won.
# JAIL_SIM_JUDGE_EFFORT=high
# JAIL_SIM_JUDGE_MAX_ROUNDS=3

# --- Observability -----------------------------------------------------------
# OTLP endpoint for traces, metrics, AND logs. When set, the backend exports all
# three telemetry signals over gRPC to any OTel-compliant collector (local
# otel-collector, Grafana/LGTM, Datadog Agent, AWS Distro, etc.).
# JAIL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5277
# Run the local collector with: docker compose --profile telemetry up otel-collector
# Console logging (JSON) always works; OTLP signals are additive.

# --- Rate limiting -----------------------------------------------------------
JAIL_RATE_LIMIT_ENABLED=true